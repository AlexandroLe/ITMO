		<region region-id="76" left="12" top="2294" width="550" height="16" align-x="12" align-y="2304" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">7. Расчет показателей готовности K2 и результирующего коэффициента комплекса K</p></text></region><region region-id="77" left="12" top="2314" width="550" height="14" align-x="12" align-y="2324" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Коэффициент готовности второй системы K2 (сумма вероятностей состояний B0...B7):</p></text></region><region region-id="78" left="24" top="2334" width="89.25" height="43.5" align-x="42.0" align-y="2356.5" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define>
					<ml:id xml:space="preserve">K2</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:parens>
							<ml:apply>
								<ml:summation/>
								<ml:lambda>
									<ml:boundVars>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:boundVars>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">b</ml:id>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:apply>
								</ml:lambda>
								<ml:bounds>
									<ml:real>0</ml:real>
									<ml:real>7</ml:real>
								</ml:bounds>
							</ml:apply>
						</ml:parens>
						<ml:result>
							<ml:real>0.99999997993123435</ml:real>
						</ml:result>
					</ml:eval>
				</ml:define>
			</math>
