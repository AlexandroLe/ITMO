		<region region-id="79" left="12" top="2518" width="500" height="14" align-x="12" align-y="2528" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Контрольное значение готовности комплекса при n1 = 2, n2 = 4, α = 2:</p></text></region><region region-id="80" left="24" top="2536" width="138.75" height="12.75" align-x="70.5" align-y="2545.0" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
